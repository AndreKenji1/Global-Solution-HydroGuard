# Copie para .env e configure valores locais. Nunca versionar .env.
# Obrigatória no Compose; escolha uma senha própria antes de iniciar.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=8080
# Cadastro administrativo opcional: os dois campos vazios desabilitam login.
ADMIN_USERNAME=
# Hash BCrypt da sua senha. Use aspas simples no .env para preservar os '$'.
# Exemplo de formato (não é um hash válido): '$2a$12$...'
ADMIN_PASSWORD_HASH=''
# Perfil de leitura administrativa opcional, sem poder alterar status.
ANALYST_USERNAME=
ANALYST_PASSWORD_HASH=''
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8
# Execução Java sem Docker: exporte também as variáveis abaixo no terminal.
JDBC_URL=jdbc:postgresql://localhost:5432/hydroguard
DB_USERNAME=hydroguard
DB_PASSWORD=
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Azure: definir no Container App; Compose usa armazenamento local.
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_CONTAINER=hydroguard-photos
COOKIE_SECURE=false
